# Secrets — never commit anything under this directory
secrets/

# Environment files anywhere in the tree
.env
.env.*
*.env

# Key material
*.pem
*.key
*_rsa
*_ed25519

# OS noise
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/
build/

# Coverage / test artifacts
.coverage
*.egg-info/

# Local dev data volume (candles, reports, journal) — never committed
core/.localdata/
